# export these variables in the shell or the scheduler (the code does not read a .env file)
# live LLM (provider "anthropic")
ANTHROPIC_API_KEY=
REVIEW_LLM_PROVIDER=anthropic
REVIEW_LLM_MODEL=claude-sonnet-5-5

# Telegram: create a bot with @BotFather, send it any message, then take your chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# optional: Wildberries feedbacks token (ingest --wildberries)
WB_FEEDBACKS_TOKEN=
